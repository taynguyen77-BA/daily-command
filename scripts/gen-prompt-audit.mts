// V2.51 A3 — regenerates docs/AI-PROMPT-AUDIT.md (one row per AI task). Run: npx tsx scripts/gen-prompt-audit.mts
// The mechanical columns (tier, budget, grounding policy, extra check) come from the registry; the editorial columns are below.
import fs from "node:fs";
import { aiTaskSchema, type AITask } from "../src/lib/command-center/ai/schemas";
import { GROUNDING_POLICY, TASK_EXTRA_CHECKS, visibleTokenBudget } from "../src/lib/command-center/ai/task-registry";
import { aiTaskTier } from "../src/lib/command-center/ai/model-config";

type Editorial = { audience: string; length: string; language?: string; note?: string };
const BA = "BA / PO / PM";
const E: Record<AITask, Editorial> = {
  analyzePriorities: { audience: BA, length: "inference 2-3 sentences; recommendation 1" },
  detectRisks: { audience: BA, length: "inference 2-3 sentences; recommendation 1" },
  explainChanges: { audience: BA, length: "1-2 sentences" },
  generateActionPlan: { audience: BA, length: "numbered plan, one line per item" },
  generateCommunication: { audience: "an owner / team (Slack-style)", length: "2-3 sentences" },
  generateEndOfDaySummary: { audience: BA, length: "<=5 bullets per list", language: "en | vi (aiOutputLanguage)" },
  interpretTrend: { audience: BA, length: "every field 1-2 sentences" },
  detectDecisionConflicts: { audience: BA, length: "assessment 2-3 sentences" },
  analyzeActionOutcomes: { audience: BA, length: "assessment 2-3 sentences" },
  generateWeeklyReview: { audience: BA, length: "<= ~350 words; 1-3 sentences per section", language: "en | vi (aiOutputLanguage)" },
  answerQuery: { audience: BA, length: "1-3 sentences" },
  assessProactive: { audience: BA, length: "assessment 1-2 sentences; impact and recommendation 1" },
  generateProjectStory: { audience: BA, length: "2-4 sentences" },
  generateDecisionOptions: { audience: BA, length: "<=3 options; 1-2 sentences per field" },
  interpretOutcome: { audience: BA, length: "summary 2-3 sentences; <=4 observed changes" },
  generateDailyGuidance: { audience: BA, length: "summary 2-3 sentences; <=3 focus/watch items", note: "UI (Next Best Action) shows only `summary`; topFocus / watch / recommendation / evidenceReferences are never displayed." },
  generateCommunicationArtifact: { audience: "stakeholders (by artifact type)", length: "3-6 sentences" },
  polishReportSummary: { audience: BA, length: "same length as the input (numbers line)", note: "Secondary since V2.50: the report narrative carries the story." },
  checkRequirements: { audience: BA, length: "summary 2-3 sentences; <=5 gaps/questions, <=3 risks" },
  generateTicketBrief: { audience: BA, length: "1-2 sentences per field; <=4 open questions", language: "en | vi (aiOutputLanguage)" },
  triageNewItems: { audience: BA, length: "one short line per item" },
  draftMentionReply: { audience: "the commenter (client / internal)", length: "2-3 sentences or <=6", language: "en | vi (per draft options)" },
  rewriteReport: { audience: "standup / PM / client / Vietnamese", length: "same size as the report", language: "audience `vi` only" },
  baRequirementCheck: { audience: BA, length: "checklist items, one sentence each" },
  draftBlockerFollowUps: { audience: "the person waited on (Slack / Jira / email)", length: "<= ~6 lines per message" },
  releaseGoNoGo: { audience: "release stakeholders", length: "communicationDraft 3-6 sentences" },
  extractMeetingActions: { audience: BA, length: "one line per item" },
  parseCommand: { audience: "the Command Bar (typed operations)", length: "n/a (structured)" },
  weeklyInsights: { audience: BA, length: "3-5 observations of 1-2 sentences; 3 one-sentence suggestions", language: "en | vi (aiOutputLanguage)" },
  summarizeReport: { audience: "a standup / work log", length: "exactly 3-5 sentences", language: "en | vi (per summary)", note: "Titles only for allow-listed projects." },
};

const rows = (aiTaskSchema.options as readonly AITask[]).map((t) => {
  const e = E[t];
  return `| \`${t}\` | ${BA === e.audience ? "IT BA / PO / PM" : "IT BA / PO / PM writing for " + e.audience} | ${e.audience} | yes (server-built prompt, schema + grounding) | ${e.length} | ${e.language ?? "English only"} | ${GROUNDING_POLICY[t]} | ${TASK_EXTRA_CHECKS[t] ? "yes" : "—"} | ${aiTaskTier(t)} | ${visibleTokenBudget(t)} / ${visibleTokenBudget(t, { language: "vi" })} |${e.note ? " " + e.note : ""}`;
});
const md = `# AI prompt audit (V2.51)

One row per AI task, generated by \`npx tsx scripts/gen-prompt-audit.mts\` (tier, budget, grounding policy and extra check come from the registry).
Budget = visible output tokens, English / Vietnamese (thinking headroom is added on top, server-side). "Facts-only" = the prompt states that only supplied facts may be used.

| Task | Role stated | Audience | Facts-only rule | Length target | Language | Grounding | Extra check | Tier | Budget en / vi | Notes |
|---|---|---|---|---|---|---|---|---|---|---|
${rows.join("\n")}

## Flags

- \`generateDailyGuidance\` asks for \`topFocus\`, \`watch\`, \`recommendation\` and \`evidenceReferences\` that the Next Best Action UI never shows (only \`summary\`). Not removed (additive-only rule) — candidate for a leaner schema later.
- Prompts for \`weeklyInsights\`, \`generateWeeklyReview\`, \`generateEndOfDaySummary\` and \`generateTicketBrief\` accept \`language: "vi"\`; with it omitted the language line is absent.
`;
fs.writeFileSync("docs/AI-PROMPT-AUDIT.md", md);
console.log(`wrote docs/AI-PROMPT-AUDIT.md (${rows.length} rows)`);
